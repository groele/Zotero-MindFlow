{
  "name": "zotero-mindflow",
  "version": "16.2.4",
  "type": "module",
  "description": "Zotero MindFlow - 面向科研文献的可视化知识组织与智能思维导图工具。 From Papers to Ideas, From Ideas to Knowledge.",
  "author": "groele",
  "license": "MIT",
  "homepage": "https://github.com/groele/Zotero-MindFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/groele/Zotero-MindFlow.git"
  },
  "scripts": {
    "build": "node scripts/build-source.mjs && python scripts/package-xpi.py",
    "build:xpi": "python scripts/package-xpi.py",
    "build:bundle": "node scripts/build-source.mjs",
    "typecheck": "npm run typecheck:host && npm --prefix source run typecheck",
    "typecheck:host": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "npm --prefix source run typecheck",
    "test": "node scripts/build-source.mjs && npm run test:architecture && node --test scripts/test-host.mjs && python scripts/test-release-package.py && python scripts/release-tags.py --self-test && npm --prefix source test",
    "test:architecture": "node --test scripts/architecture-guard.mjs",
    "test:host": "node --test scripts/test-host.mjs",
    "test:frontend": "npm --prefix source test",
    "test:package": "python scripts/test-release-package.py",
    "test:tags": "python scripts/release-tags.py --self-test"
  },
  "keywords": [
    "zotero",
    "zotero-flow",
    "mindflow",
    "mindmap",
    "knowledge",
    "research"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
