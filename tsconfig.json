{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@host/*": ["./src/host/*"]
    }
  },
  "include": ["src/**/*"]
}
